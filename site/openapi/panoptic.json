{
  "openapi": "3.1.0",
  "info": {
    "title": "Panoptic Visual API",
    "version": "1.0.0",
    "description": "Host-controlled persistent visual session. The trusted host owns capture and action execution. OpenAPI documents HTTP routes, not the streaming WebSocket."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8790",
      "description": "Local runtime"
    },
    {
      "url": "https://visual.example",
      "description": "Replace with your assigned runtime"
    }
  ],
  "tags": [
    {
      "name": "Sessions"
    },
    {
      "name": "Perception"
    },
    {
      "name": "Decisions"
    },
    {
      "name": "History"
    },
    {
      "name": "Host"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "TaskRequest": {
        "type": "object",
        "required": [
          "goal"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DecisionRequest": {
        "type": "object",
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "PerceptionRequest": {
        "type": "object",
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AttemptRequest": {
        "type": "object",
        "required": [
          "decision_id"
        ],
        "properties": {
          "decision_id": {
            "type": "string"
          }
        }
      },
      "InspectionRequest": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "string"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "display_size": {
            "type": "integer",
            "minimum": 64
          }
        }
      },
      "PixelRequest": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "frame_id": {
            "type": "string"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "step": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getVisualHealth",
        "summary": "Check service health",
        "tags": [
          "Sessions"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/visual/sessions": {
      "post": {
        "operationId": "createVisualSession",
        "summary": "Create a session",
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/visual/sessions/{session_id}": {
      "get": {
        "operationId": "readSession",
        "summary": "Read session state",
        "tags": [
          "Sessions"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "closeVisualSession",
        "summary": "Close host session",
        "tags": [
          "Host"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/visual/sessions/{session_id}/perceptions": {
      "post": {
        "operationId": "perceive",
        "summary": "Perceive the rolling scene",
        "tags": [
          "Perception"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PerceptionRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/visual/sessions/{session_id}/task": {
      "put": {
        "operationId": "setTask",
        "summary": "Set task and allowed actions",
        "tags": [
          "Decisions"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "resetTask",
        "summary": "Reset task",
        "tags": [
          "Decisions"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/visual/sessions/{session_id}/decisions": {
      "post": {
        "operationId": "decide",
        "summary": "Propose a bounded action",
        "tags": [
          "Decisions"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/visual/sessions/{session_id}/attempts": {
      "post": {
        "operationId": "recordAttempt",
        "summary": "Record host action attempt",
        "tags": [
